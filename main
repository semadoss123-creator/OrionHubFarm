--!strict
--=========================================================================
--  MeshTeleport — телепорт по объектам с заданным MeshId.
--  GUI создаётся сам, скорость полёта и пауза настраиваются в панели.
--
--  Куда положить: Workspace -> Script, у скрипта RunContext = Client.
--===========================a==============================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

if not RunService:IsClient() then
	warn("[MeshTeleport] Нужен RunContext = Client. Скрипт остановлен.")
	return
end

local localPlayer = Players.LocalPlayer
if not localPlayer then
	repeat
		task.wait()
	until Players.LocalPlayer ~= nil
	localPlayer = Players.LocalPlayer
end
local player: Player = localPlayer :: Player
local playerGui = player:WaitForChild("PlayerGui")

--============================================================== настройки

local MESH_ID = 139025296710661   -- id меша, по которому ищем
local HEIGHT  = 2.1               -- от низа монеты до центра персонажа: монета встаёт на голову

local state = {
	travelSpeed = 30,  -- 0 = мгновенно, иначе студов в секунду (плавный полёт)
	autoDelay = 1.5,   -- пауза между прыжками в авто-режиме
	noclip = false,    -- сквозь стены: все детали мира нетвёрдые для этого клиента
	tickInterval = 0.5,
}

--============================================================== поиск объекта

-- Достаёт число из любой записи меша: "rbxassetid://123",
-- "http://www.roblox.com/Asset/?id=123" и из Content-свойства.
local function meshIdOf(instance: Instance): number?
	local raw = (instance :: any).MeshId
	if typeof(raw) ~= "string" or raw == "" then
		local content = (instance :: any).MeshContent
		if content == nil then
			return nil
		end
		raw = tostring(content)
	end

	local digits = string.match(raw :: string, "(%d+)")
	return digits and tonumber(digits) or nil
end

-- MeshPart несёт меш сам, SpecialMesh лежит внутри обычного Part
local function targetOf(instance: Instance): BasePart?
	if instance:IsA("MeshPart") then
		if meshIdOf(instance) == MESH_ID then
			return instance
		end
	elseif instance:IsA("SpecialMesh") then
		local parent = instance.Parent
		if parent and parent:IsA("BasePart") and meshIdOf(instance) == MESH_ID then
			return parent
		end
	end
	return nil
end

local function getRoot(): BasePart?
	local character = player.Character
	if not character then
		return nil
	end
	return (character:FindFirstChild("HumanoidRootPart") :: BasePart?) or character.PrimaryPart
end

--============================================================== состояние полёта

-- Объявлено раньше ноклипа: setNoclip обращается к этим значениям,
-- а в Lua локальная переменная видна только после её объявления.
local travelToken = 0
local flying = false
local activeFlights = 0   -- полётов может быть несколько: старый отменяется новым

local FLY_STATE_REFRESH = 0.1   -- как часто подтверждать состояние Physics

-- На время полёта персонаж переводится в состояние Physics: иначе Humanoid
-- сопротивляется прямым перемещениям CFrame. По окончании полёта состояние
-- ВСЕГДА возвращается в обычное — иначе игрок не сможет ходить,
-- даже если noclip оставлен включённым.
local function setFlightState(flyingNow: boolean)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	if flyingNow then
		humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	else
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
end

--============================================================== сквозь стены

-- Обычный noclip: твёрдость гасится у деталей самого персонажа, поэтому
-- он проходит сквозь стены. Мир при этом не трогается — сервер и другие
-- игроки видят обычную игру.
local characterCollide: { [BasePart]: boolean } = {}

local function setCharacterCollide(enabled: boolean)
	local character = player.Character
	if not character then
		table.clear(characterCollide)
		return
	end

	if enabled then
		-- возвращаем твёрдость только тем деталям, что ещё в персонаже
		for part, wasCollidable in pairs(characterCollide) do
			if part.Parent and not part.CanCollide then
				part.CanCollide = wasCollidable
			end
		end
		table.clear(characterCollide)
		return
	end

	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			if characterCollide[part] == nil then
				characterCollide[part] = part.CanCollide
			end
			part.CanCollide = false
		end
	end
end

-- На время авто-режима персонаж удерживается в точке назначения:
-- скорость обнуляется каждый кадр, при смещении он возвращается на точку.
-- Anchored НЕ ставим намеренно: заанчоренная деталь выпадает из физической
-- симуляции, и событие Touched на монете перестаёт срабатывать —
-- персонаж касается монеты, но она не собирается.
local holdPosition: Vector3? = nil

-- Персонаж без коллизий начинает проваливаться вниз, поэтому высоту
-- держим сами: ищем пол под персонажем и не даём уйти ниже его.
-- Если пол не найден (персонаж уже под картой), поднимаем на последнюю
-- известную безопасную высоту.
local FLOOR_PROBE = 600      -- на сколько студов вниз щупаем пол
local FLOOR_GAP = 3          -- на сколько держаться над полом
local lastSafeY: number? = nil
local holdY: number? = nil   -- точка, где персонаж оставлен после полёта

local floorParams = RaycastParams.new()
floorParams.FilterType = Enum.RaycastFilterType.Exclude
floorParams.IgnoreWater = true

local function applyFloorGuard()
	local character = player.Character
	local root = getRoot()
	if not character or not root then
		return
	end

	-- персонаж оставлен в точке назначения (под монетой) — не толкаем его
	-- наверх, даже если эта точка ниже уровня пола карты
	if holdY and math.abs(root.Position.Y - holdY) <= 1.5 then
		return
	end

	floorParams.FilterDescendantsInstances = { character }

	local origin = root.Position + Vector3.new(0, FLOOR_GAP, 0)
	local result = workspace:Raycast(origin, Vector3.new(0, -FLOOR_PROBE, 0), floorParams)

	if result then
		local limit = result.Position.Y + FLOOR_GAP
		lastSafeY = limit
		if root.Position.Y < limit then
			root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z)
			root.CFrame = root.CFrame + Vector3.new(0, limit - root.Position.Y, 0)
		end
	elseif lastSafeY and root.Position.Y < lastSafeY then
		root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z)
		root.CFrame = root.CFrame + Vector3.new(0, lastSafeY - root.Position.Y, 0)
	end
end

local function setNoclip(enabled: boolean)
	state.noclip = enabled

	if enabled then
		local root = getRoot()
		lastSafeY = root and root.Position.Y or nil
		setCharacterCollide(false)
		applyFloorGuard()
		-- ноклип не должен оставлять игрока в состоянии Physics
		if not flying then
			setFlightState(false)
		end
	else
		setCharacterCollide(true)
	end
end

--============================================================== список целей

local partSet: { [BasePart]: boolean } = {}
local foundParts: { BasePart } = {}
local sorted: { BasePart } = {}

local dirty = true
local currentPart: BasePart? = nil
local currentIndex = 0
local auto = false

local function addTarget(part: BasePart): boolean
	if partSet[part] then
		return false
	end
	partSet[part] = true
	foundParts[#foundParts + 1] = part
	return true
end

local function removeTarget(part: BasePart): boolean
	if not partSet[part] then
		return false
	end
	partSet[part] = nil
	for i = #foundParts, 1, -1 do
		if foundParts[i] == part then
			table.remove(foundParts, i)
			break
		end
	end
	return true
end

-- Полный проход по Workspace нужен только при старте, по кнопке «Обновить»
-- и при открытии панели. Дальше список ведётся инкрементально по событиям.
local function fullScan()
	table.clear(partSet)
	table.clear(foundParts)

	for _, instance in ipairs(workspace:GetDescendants()) do
		local part = targetOf(instance)
		if part then
			addTarget(part)
		end
	end

	dirty = true
end

-- Появившиеся и исчезнувшие объекты (в том числе подгруженные стримингом)
workspace.DescendantAdded:Connect(function(instance)
	local part = targetOf(instance)
	if part and addTarget(part) then
		dirty = true
	end
end)

workspace.DescendantRemoving:Connect(function(instance)
	local part = targetOf(instance)
	if part and removeTarget(part) then
		dirty = true
	end
end)

--============================================================== перемещение

-- Точка назначения — ПОД объектом: XZ совпадает с монетой,
-- высота ниже её нижней грани на HEIGHT студов.
local function targetSpot(part: BasePart): Vector3
	return part.Position - Vector3.new(0, part.Size.Y * 0.5 + HEIGHT, 0)
end

-- speed <= 0 — мгновенный телепорт, иначе полёт с заданной скоростью
local function flyTo(root: BasePart, goal: Vector3)
	local orientation = CFrame.Angles(0, select(2, root.CFrame:ToEulerAnglesYXZ()), 0)
	local speed = state.travelSpeed

	local function place(position: Vector3)
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		root.CFrame = CFrame.new(position) * orientation
	end

	if speed <= 0 or (goal - root.Position).Magnitude < 0.5 then
		place(goal)
		holdY = goal.Y
		holdPosition = goal
		return
	end

	travelToken += 1
	local myToken = travelToken

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local heartbeat = RunService.Heartbeat
	local stateClock = 0

	-- Расчётная точка на прямой старт→цель. Не зависит от того, куда
	-- гравитация сдвинула персонаж между кадрами — иначе путь «сползает»
	-- вниз и персонаж дёргается вверх-вниз.
	local flightPosition = root.Position

	flying = true
	activeFlights += 1
	setFlightState(true)
	setCharacterCollide(false)

	while travelToken == myToken and root.Parent ~= nil do
		local deltaTime = heartbeat:Wait()
		local delta = goal - flightPosition
		local distance = delta.Magnitude

		if distance < 0.05 then
			holdY = goal.Y
			holdPosition = goal
			break
		end

		local step = speed * deltaTime
		if step >= distance then
			flightPosition = goal
			place(goal)
			holdY = goal.Y
			holdPosition = goal
			break
		end

		flightPosition = flightPosition + delta.Unit * step
		place(flightPosition)
		holdY = flightPosition.Y

		-- Physics-состояние иногда слетает само, поэтому подтверждаем его
		stateClock += deltaTime
		if stateClock >= FLY_STATE_REFRESH and humanoid and humanoid.Parent then
			stateClock = 0
			humanoid:ChangeState(Enum.HumanoidStateType.Physics)
		end
	end

	-- Этот блок выполняется и при отмене полёта новым кликом: важно, чтобы
	-- коллизии и управление вернулись, когда закончился ПОСЛЕДНИЙ полёт.
	activeFlights -= 1
	if activeFlights <= 0 then
		activeFlights = 0
		flying = false
		setFlightState(false)   -- всегда возвращаем управление игроку
		-- при включённом noclip коллизии остаются выключенными
		if not state.noclip then
			setCharacterCollide(true)
		end
	end
end

