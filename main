--============================================================== логика GUI

local auto = false
local sliderDragging = false

local function setSpeed(value: number)
	-- 0 = мгновенно, максимум 600
	state.travelSpeed = math.clamp(math.floor(value + 0.5), 0, 600)
	speedBox.Text = tostring(state.travelSpeed)
	sliderFill.Size = UDim2.fromScale(state.travelSpeed / 600, 1)
end

local function updateToggleVisual()
	if auto then
		toggleKnob.Position = UDim2.new(0, 26, 0.5, -10)
		toggleKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		toggleTrack.BackgroundColor3 = Color3.fromRGB(90, 165, 255)
	else
		toggleKnob.Position = UDim2.new(0, 2, 0.5, -10)
		toggleKnob.BackgroundColor3 = Color3.fromRGB(205, 208, 214)
		toggleTrack.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	end
end

-- Слайдер скорости: перетаскивание
sliderTrack.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
	then
		sliderDragging = true
		local width = math.max(sliderTrack.AbsoluteSize.X, 1)
		local fraction = math.clamp((input.Position.X - sliderTrack.AbsolutePosition.X) / width, 0, 1)
		setSpeed(fraction * 600)
	end
end)

sliderTrack.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
	then
		sliderDragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not sliderDragging then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch
	then
		local width = math.max(sliderTrack.AbsoluteSize.X, 1)
		local fraction = math.clamp((input.Position.X - sliderTrack.AbsolutePosition.X) / width, 0, 1)
		setSpeed(fraction * 600)
	end
end)

-- Ручной ввод скорости в поле
speedBox.FocusLost:Connect(function(enterPressed: boolean)
	local number = tonumber(speedBox.Text)
	if number == nil then
		setSpeed(state.travelSpeed)
		return
	end
	setSpeed(number)
	if enterPressed then
		speedBox:ReleaseFocus()
	end
end)

-- Тумблер: вкл/выкл авто-режима
toggleTrack.MouseButton1Click:Connect(function()
	auto = not auto
	updateToggleVisual()

	if not auto then
		setFlightState(false)
		return
	end

	-- Авто-режим всегда работает с ноклипом
	if not state.noclip then
		setNoclip(true)
	end

	-- персонаж удерживается в точке
	setFlightState(true)

	task.spawn(function()
		while auto do
			if #sorted == 0 then
				task.wait(0.25)
			else
				goStep(1)
				while flying and auto do
					task.wait(0.05)
				end
				if auto then
					task.wait(state.autoDelay)
				end
			end
		end
	end)
end)

-- Кнопка скрытия
hideBtn.MouseButton1Click:Connect(function()
	panel.Visible = false
end)

-- Кнопка открытия
openBtn.MouseButton1Click:Connect(function()
	panel.Visible = not panel.Visible
	if panel.Visible then
		fullScan()
		applyMembership()
	end
end)
--============================================================== логика списка

local function sortTargets()
	local root = getRoot()
	local origin = root and root.Position or Vector3.zero

	table.clear(sorted)
	for i = 1, #foundParts do
		sorted[i] = foundParts[i]
	end

	table.sort(sorted, function(a, b)
		return (a.Position - origin).Magnitude < (b.Position - origin).Magnitude
	end)
end

local function indexOfPart(part: BasePart): number
	for i = 1, #sorted do
		if sorted[i] == part then
			return i
		end
	end
	return 0
end

local function applyMembership()
	dirty = false
	sortTargets()

	if currentPart and partSet[currentPart] then
		currentIndex = indexOfPart(currentPart)
	else
		currentPart = nil
		currentIndex = 0
	end
end

--============================================================== переходы

local goToIndex: (number) -> ()

goToIndex = function(target: number)
	if #sorted == 0 then
		return
	end
	if target < 1 or target > #sorted then
		return
	end

	local part = sorted[target]
	if not part or not part.Parent then
		dirty = true
		return
	end

	currentPart = part
	currentIndex = target

	local root = getRoot()
	if not root then
		return
	end

	task.spawn(function()
		flyTo(root, targetSpot(part))
		if currentPart == part then
			currentIndex = indexOfPart(part)
		end
	end)
end

goStep = function(step: number)
	if #sorted == 0 then
		return
	end

	local base = currentIndex
	if base < 1 or base > #sorted then
		base = 0
	end

	local target = base + step
	if target > #sorted then
		target = 1
	elseif target < 1 then
		target = #sorted
	end

	goToIndex(target)
end

--============================================================== удержание
--
-- Пока активен авто-режим и полёт не идёт, персонаж держим в точке под
-- монетой: обнуляем скорость каждый кадр, а если его всё же сдвинуло
-- (толчок, скрипт игры) — возвращаем на место. Персонаж при этом остаётся
-- в физической симуляции, поэтому Touched на монете срабатывает и она
-- собирается.
task.spawn(function()
	local heartbeat = RunService.Heartbeat
	while screenGui.Parent do
		heartbeat:Wait()
		if not auto or flying then
			continue
		end

		local root = getRoot()
		if not root then
			continue
		end

		-- подтверждаем Physics: гуманоид не сопротивляется удержанию
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid:ChangeState(Enum.HumanoidStateType.Physics)
		end

		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero

		if holdPosition and (root.Position - holdPosition).Magnitude > 0.25 then
			local yaw = select(2, root.CFrame:ToEulerAnglesYXZ())
			root.CFrame = CFrame.new(holdPosition) * CFrame.Angles(0, yaw, 0)
		end
	end
end)

--============================================================== запуск



player.CharacterAdded:Connect(function()
	-- персонаж пересоздан: сбрасываем состояние полёта от прошлой жизни
	travelToken += 1
	activeFlights = 0
	flying = false
	setFlightState(false)
	table.clear(characterCollide)
	lastSafeY = nil
	holdY = nil
	holdPosition = nil

	task.wait(0.5)

	-- на новом персонаже заново гасим коллизии, если ноклип был включён
	if state.noclip then
		local root = getRoot()
		lastSafeY = root and root.Position.Y or nil
		setCharacterCollide(false)
	end

	-- если персонаж умер во время авто-режима — на новом персонаже
	-- сразу включаем ноклип и фиксацию, не дожидаясь следующего тика
	if auto then
		if not state.noclip then
			setNoclip(true)
		end
		setFlightState(true)
	end

	fullScan()
	applyMembership()
end)

-- Фоновый цикл: собирает изменения не чаще tickInterval.
task.spawn(function()
	while screenGui.Parent do
		task.wait(state.tickInterval)

		if dirty then
			applyMembership()
		end

		-- при включённом noclip держим персонажа над полом и повторно
		-- гасим коллизии: за это время у персонажа могли появиться новые
		-- детали (инструменты, аксессуары) с твёрдым CanCollide
		if state.noclip then
			setCharacterCollide(false)
			applyFloorGuard()
		end
	end
end)

-- Пол стережём отдельно и часто: за один тик фонового цикла персонаж
-- без коллизий успевает провалиться на десятки студов.
task.spawn(function()
	while screenGui.Parent do
		RunService.Heartbeat:Wait()
		if state.noclip and not flying then
			applyFloorGuard()
		end
	end
end)

setSpeed(state.travelSpeed)
fullScan()
applyMembership()
